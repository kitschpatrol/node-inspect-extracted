{
  "name": "@kitschpatrol/node-inspect-extracted",
  "version": "3.3.3-fork.1",
  "description": "Fork of node-inspect-extracted with ESM fixes.",
  "keywords": [
    "inspect",
    "util",
    "polyfill",
    "format",
    "output",
    "npm-package"
  ],
  "homepage": "https://github.com/kitschpatrol/node-inspect-extracted",
  "bugs": "https://github.com/kitschpatrol/node-inspect-extracted/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitschpatrol/node-inspect-extracted.git"
  },
  "license": "MIT",
  "author": {
    "name": "Joe Hildebrand",
    "email": "joe-github@cursive.net",
    "url": "https://github.com/hildjj"
  },
  "contributors": [
    {
      "name": "Eric Mika",
      "email": "eric@ericmika.com",
      "url": "https://ericmika.com"
    },
    {
      "name": "Noah May",
      "email": "noahmouse2011@gmail.com"
    },
    {
      "name": "Node.js contributors"
    }
  ],
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./types/util.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./types/util.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "jsdelivr": "./dist/inspect.js",
  "unpkg": "./dist/inspect.js",
  "module": "./dist/index.mjs",
  "types": "./types/util.d.ts",
  "files": [
    "dist/",
    "types/"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "node tools/check",
    "ci": "c8 nve --arch ${NVE_ARCH:-`node -e 'console.log(process.arch)'`} --no-progress -c -p 14.6.0,16,18,20,22,24,26 node tools/runtests",
    "clean": "rm -f pnpm-lock.yaml && git clean -fdX",
    "coverage": "c8 node tools/runtests",
    "example-esm": "vite --open /example-esm/",
    "example": "vite --open /example/",
    "fix": "eslint . --fix && mdat && ksc-prettier fix",
    "lint": "eslint . && mdat check --format && ksc-prettier lint && diff -q types/util.d.mts types/util.d.ts",
    "preci": "npm run build && npm run lint",
    "prepack": "npm run build",
    "pretest:all": "npm run build",
    "pretest": "npm run build",
    "release": "bumpp --preid fork --commit 'Release: %s' && pnpm build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish --tag latest",
    "test:all": "nve --arch ${NVE_ARCH:-`node -e 'console.log(process.arch)'`} -p 14.6.0,16,18,20,22,24,26 node tools/runtests",
    "test:all-macos": "nve --arch ${NVE_ARCH:-`node -e 'console.log(process.arch)'`} -p 16,18,20,22,24,26 node tools/runtests",
    "test": "node tools/runtests"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-import-defer": "^8.0.1",
    "@babel/plugin-syntax-import-source": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@kitschpatrol/prettier-config": "^8.5.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "baseline-browser-mapping": "^2.11.4",
    "eslint": "^10.8.0",
    "eslint-plugin-jsdoc": "^63.3.1",
    "eslint-plugin-regexp": "^3.1.1",
    "globals": "^17.8.0",
    "mdat": "^3.0.0",
    "nve": "^18.0.3",
    "bumpp": "^12.0.0",
    "semver": "^7.8.5",
    "superc8": "^12.7.0",
    "tsdown": "^0.22.14",
    "vite": "^8.1.5"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=14.6.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || >=24.11.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
